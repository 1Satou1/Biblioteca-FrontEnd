pipeline {
  agent any

  triggers { pollSCM('* * * * *') }

  stages {

    stage('Instalar dependencias') {
      steps {
        bat 'npm ci'
      }
    }

    stage('Build') {
      steps {
        bat 'npm run build'
      }
    }

    stage('Análisis SonarQube') {
      steps {
        withSonarQubeEnv('SonarServer') {
          bat 'npx sonar-scanner -Dsonar.organization=1satou1 -Dsonar.projectKey=1Satou1_Biblioteca-FrontEnd -Dsonar.sources=src -Dsonar.host.url=https://sonarcloud.io'
        }
      }
    }

  }

  post {
    failure {
      emailext to: 'migueltamayo978@gmail.com',
               subject: 'Pipeline falló - Biblioteca Frontend',
               body: 'El código no pasó el análisis de SonarQube.'
    }
    success {
      emailext to: 'migueltamayo978@gmail.com',
               subject: 'Pipeline exitoso - Biblioteca Frontend',
               body: 'El código pasó SonarQube. Vercel desplegará automáticamente.'
    }
  }
}
