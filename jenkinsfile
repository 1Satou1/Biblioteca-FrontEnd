pipeline {
  agent any

  triggers { pollSCM('* * * * *') }

  stages {

    stage('Instalar dependencias') {
      steps {
        sh 'npm ci'
      }
    }

    stage('Build') {
      steps {
        sh 'npm run build'
      }
    }

    stage('Análisis SonarQube') {
      steps {
        withSonarQubeEnv('SonarServer') {
          sh 'npx sonar-scanner'
        }
      }
    }

    stage('Quality Gate') {
      steps {
        waitForQualityGate abortPipeline: true
      }
    }

    stage('Deploy producción') {
      steps {
        sh 'rsync -avz dist/ usuario@servidor:/var/www/html/biblioteca/'
      }
    }

  }

  post {
    failure {
      mail to: 'dev@ejemplo.com',
           subject: 'Pipeline falló - Biblioteca Frontend',
           body: 'SonarQube detectó problemas en el código. Revisa el reporte.'
    }
    success {
      mail to: 'dev@ejemplo.com',
           subject: 'Deploy exitoso - Biblioteca Frontend',
           body: 'El frontend pasó SonarQube y fue desplegado correctamente.'
    }
  }
}